VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=5242880
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# Optional CCTV feature (see media/README.md). Use distinct random values.
CCTV_ENABLED=false
CCTV_ENCRYPTION_KEY=
CCTV_CONTROL_TOKEN=
CCTV_EDGE_TOKEN=
JWT_SECRET=
MEDIAMTX_API_URL=http://mediamtx:9997
# Loopback for development, or a private VPN interface IP for remote relays.
CCTV_INGEST_BIND=127.0.0.1
# Exact frontend origin for a split deployment; leave empty for same-origin playback.
CCTV_PLAYER_ORIGIN=
# Optional Vite development proxy override, e.g. http://localhost (the nginx gateway).
VITE_PROXY_TARGET=
