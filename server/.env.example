# ─── Server ───────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── JWT ──────────────────────────────────────
JWT_SECRET=replace-me-with-a-random-string

# ─── Default Admin Account ────────────────────
# Used by db/seed.js to create the initial admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ─── PostgreSQL / PostGIS ─────────────────────
# Either use DATABASE_URL or individual DB_* variables
DATABASE_URL=postgres://impex:impex_dev_password@localhost:5432/impex_spot
# Individual variables (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=impex_spot
# DB_USER=impex
# DB_PASSWORD=impex_dev_password
# Set true only when your DB endpoint requires SSL
DB_SSL=false

# ─── Redis (optional) ────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Upload ──────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─── Rate Limiting ───────────────────────────
# MAX_LOGIN_ATTEMPTS=5 (per 15 min window)
# ADMIN_API_RATE_LIMIT=200 (per minute)
